{
    "name": "axitdev/phpunit-ai-evals-examples",
    "description": "Runnable examples for axitdev/phpunit-ai-evals",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/http": "^12.0",
        "openai-php/client": "^0.18",
        "symfony/http-client": "^7.3"
    },
    "require-dev": {
        "axitdev/phpunit-ai-evals": "0.0.2",
        "opis/json-schema": "^2.4",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
